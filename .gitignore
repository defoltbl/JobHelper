# Secrets & local config (also the copy left behind when the data moved to the Library)
.env
.env_moved_to_Library*

# Python
.venv/
venv/
__pycache__/
*.pyc

# Local data: your CV, letters, rules, tracking tables, the database, backups, logs.
# The app keeps it in ~/Library/Application Support/JobHelper; an older copy in the
# project folder, and the folder left behind when it moved, stay out too.
data/
data_moved_to_Library*/

# Test and tool caches
.pytest_cache/

# OS / editor
.DS_Store

# The built app and PyInstaller's work folder
build/
dist/
# a write cut short can leave a part file with the mail password in it
.env.*.part
