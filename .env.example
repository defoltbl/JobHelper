# ── JobHelper configuration ──────────────────────────────────────────────
# Copy this file to ".env" and fill in what you have. Everything is optional
# except that you must be LOGGED IN to Claude Code (run `claude` once and sign
# in with your subscription). Do NOT set ANTHROPIC_API_KEY — leaving it unset
# is what makes the app use your subscription instead of paid API billing.

# Which model the agents use. Options: sonnet | opus | haiku
# sonnet is the best value for this workload. opus = highest quality.
JOBHELPER_MODEL=sonnet

# ── Job search ─────────────────────────────────────────────────────────────
# Jooble covers the CZECH REPUBLIC (Prague). Free key: https://jooble.org/api/about
JOOBLE_API_KEY=

# Adzuna does NOT support Czech — use it for other countries (pl, de, gb, at,
# au, be, br, ca, ch, es, fr, in, it, mx, nl, nz, sg, us, za). Free key at
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=pl

# ── Email sync (Agent 4, optional) ─────────────────────────────────────────
# Reads replies from your inbox to update application status. READ ONLY —
# the app never sends, deletes, or marks emails. For Gmail create an
# "App Password" (Google Account → Security → App passwords), not your real one.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# Do NOT put the App Password here. Enter it in the app (Account chip -> Job email
# -> Change): it is stored in the macOS Keychain. A value left here is moved to
# the Keychain and removed from .env at the next start.
IMAP_PASSWORD=
# Only look at emails from the last N days when syncing. Raise this to scan
# your whole job-search history (e.g. 120 covers ~4 months).
IMAP_LOOKBACK_DAYS=120

# ── Your own cover letters ─────────────────────────────────────────────────
# Folder of pre-written cover letters (named like ..._CoverLetter_<Company>.docx).
# They get linked to jobs in the tracker. Defaults to ~/Documents/CV/Letter.
COVER_LETTERS_DIR=
