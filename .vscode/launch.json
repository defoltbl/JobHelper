{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run full pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run pipeline — reuse profile",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--reuse-profile"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Status: list jobs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/status.py",
      "args": ["list"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Status: sync email",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/status.py",
      "args": ["sync"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
